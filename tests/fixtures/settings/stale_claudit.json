      { "matcher": "Bash", "hooks": [{ "type": "command", "command": "/Users/alice/bin/log.sh" }] },
      { "hooks": [{ "type": "command", "command": "'/opt/old place/claudit' hook", "async": true }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "/usr/local/bin/claudit hook", "async": true }] }
    ]
  }
}
