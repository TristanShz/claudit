{
  "model": "opus",
  "permissions": { "allow": ["Bash(git status)"], "deny": [] },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "/Users/alice/bin/guard.sh", "timeout": 5 }]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "npx prettier --check" }]
      }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "say done", "async": true }] }
    ],
    "PreCompact": [
      { "matcher": "auto", "hooks": [{ "type": "command", "command": "echo compacting" }] }
    ]
  },
  "statusLine": { "type": "command", "command": "~/.claude/statusline.sh" },
  "someFutureSetting": { "nested": [1, 2, 3] }
}
